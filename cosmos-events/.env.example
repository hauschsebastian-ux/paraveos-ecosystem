# ---- Cosmos Events Dashboard – Konfiguration ----
# Kopiere diese Datei nach .env und passe die Werte an.

# Port, auf dem der Server lauscht
PORT=3000
NODE_ENV=production

# Öffentliche Basis-URL (für Origin-Prüfung / CSRF-Schutz, kommasepariert möglich)
APP_ORIGIN=https://dashboard.cosmos-events.de

# Hinter einem Reverse-Proxy (nginx, Caddy, Traefik) mit TLS-Terminierung: 1
TRUST_PROXY=1

# Direktes HTTPS ohne Reverse-Proxy (optional): Pfade zu Zertifikat und Schlüssel
# TLS_CERT_FILE=/etc/ssl/certs/fullchain.pem
# TLS_KEY_FILE=/etc/ssl/private/privkey.pem

# 32 Byte, hex-kodiert (64 Zeichen). Erzeugen mit: openssl rand -hex 32
# Schlüssel für die Verschlüsselung sensibler Daten (Dokumente, TOTP-Secrets, Backups).
# Wird er nicht gesetzt, wird beim ersten Start einer erzeugt und in data/keys/ abgelegt.
# DATA_ENCRYPTION_KEY=

# Datenverzeichnis (Datenbank, Uploads, Backups, Schlüssel)
DATA_DIR=./data

# Rollen, für die Zwei-Faktor-Authentifizierung verpflichtend ist
REQUIRE_2FA_ROLES=admin,dj

# Sitzungsdauer in Stunden
SESSION_HOURS=12

# Standard-Provision von Cosmos Events in Prozent (pro Event überschreibbar)
DEFAULT_COMMISSION_PERCENT=15

# Backups: Uhrzeit (Stunde, 0–23) und Aufbewahrung in Tagen
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=30

# Spotify Web API (Client-Credentials-Flow für die Songsuche)
# Anlegen unter https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Erst-Admin (wird nur angelegt, wenn noch kein Admin existiert)
ADMIN_EMAIL=admin@cosmos-events.de
# Wenn leer, wird ein zufälliges Passwort erzeugt und einmalig im Log ausgegeben.
# ADMIN_PASSWORD=
